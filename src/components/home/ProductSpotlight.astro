---
import Button from '@components/ui/Button.astro';
---

<section class="section bg-brand-gradient text-white relative overflow-hidden">
  <!-- Decorative blobs -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="text-center lg:text-left">
        <p class="text-white/70 uppercase tracking-widest text-sm font-semibold mb-4">Our Product</p>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-4">
          Automate It
        </h2>
        <p class="text-xl md:text-2xl font-semibold mb-4">
          Social media on autopilot. No slop allowed.
        </p>
        <p class="text-white/80 mb-8 max-w-xl mx-auto lg:mx-0">
          Create automations in plain English. AI agents draft your posts, threads, articles, and podcasts — you approve with a swipe, and only what you approve gets published.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
          <Button href="https://automate.it.com" variant="secondary" size="lg" external class="whitespace-nowrap">
            Try Automate It
          </Button>
          <a href="/services/custom-automations" class="text-white/90 font-semibold underline underline-offset-4 hover:text-white transition-colors">
            Need something custom? We build automations for clients →
          </a>
        </div>
      </div>

      <!-- Bolt tile -->
      <div class="hidden lg:flex justify-center">
        <div class="w-56 h-56 rounded-3xl bg-white/15 border border-white/30 flex items-center justify-center shadow-2xl backdrop-blur-sm">
          <svg viewBox="0 0 48 48" class="w-36 h-36">
            <polygon points="30,6 16,27 23,27 18,42 34,21 26,21" fill="#ffffff" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
