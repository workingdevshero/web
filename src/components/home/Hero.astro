---
import Button from '@components/ui/Button.astro';
import tallPoster from '@assets/images/hero-midnight-tall-poster.jpg';
import widePoster from '@assets/images/hero-midnight-wide-poster.jpg';
import { getImage } from 'astro:assets';

// Posters are each loop's first frame (scripts/build-hero-video.mjs), so nothing
// jumps when playback starts, and they are what reduced-motion visitors see.
const wide = await getImage({ src: widePoster, width: 1280, format: 'webp' });
const tall = await getImage({ src: tallPoster, width: 720, format: 'webp' });
---

<section class="relative overflow-hidden bg-[#2d1941]">
  <!-- Composition wrapper: caps the scene+text at 1920px and centers both on ultrawide displays;
       #2d1941 is the scene's night-sky color, so pillars and fades stay seamless beyond it -->
  <div class="relative max-w-[120rem] mx-auto">
    <!-- Full-bleed rooftop loop (desktop); the opaque sky canvas replaces the mobile gradient at lg+
         and both video edges fade into it -->
    <div class="absolute inset-0 hidden lg:block bg-[#2d1941]" aria-hidden="true">
      <!-- right-44 keeps the hero where the old, wider still had him and the sidekick clear of the edge fade -->
      <div class="absolute inset-y-0 right-44 h-full aspect-video">
        <video
          data-hero-video
          src="/videos/hero-midnight-wide.mp4"
          poster={wide.src}
          muted
          loop
          playsinline
          preload="none"
          class="h-full w-full object-cover"
        ></video>
        <!-- The loop's left edge carries a pink glow; on ultrawide it lands past the text fade below -->
        <div class="absolute inset-y-0 left-0 w-40 bg-gradient-to-r from-[#2d1941] to-transparent"></div>
        <div class="absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-[#2d1941] to-transparent"></div>
      </div>
      <div class="absolute inset-y-0 left-0 w-3/5 bg-gradient-to-r from-[#2d1941] from-45% to-transparent"></div>
      <div class="absolute inset-y-0 right-0 w-48 bg-gradient-to-l from-[#2d1941] from-[25%] via-[#2d1941]/80 to-transparent"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 md:pt-24 lg:pt-32 pb-16 md:pb-40 lg:pb-48">
    <div class="grid lg:grid-cols-2 gap-4 md:gap-8 lg:gap-12 items-center">
      <!-- Text Content (on phones it overlaps the banner's faded bottom) -->
      <div class="relative z-10 text-center lg:text-left -mt-24 md:mt-0">
        <h1 class="text-[clamp(1.625rem,7vw,1.875rem)] md:text-5xl lg:text-6xl font-heading font-bold text-white leading-tight mb-6">
          We Build
          <span class="bg-gradient-to-r from-secondary-400 to-brand-pink bg-clip-text text-transparent"> AI&#8209;Powered</span>
          <br />Software That Ships
        </h1>
        <p class="text-base md:text-xl text-white/80 mb-8 max-w-xl mx-auto lg:mx-0">
          From concept to production — your AI-enabled development partner. We help startups and enterprises build intelligent software solutions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <Button href="/contact" variant="primary" size="lg">
            Start Your Project
          </Button>
          <Button href="/portfolio" variant="secondary" size="lg">
            See Our Work
          </Button>
        </div>
      </div>

      <!-- Hero loop (mobile/tablet full-bleed banner whose bottom fades into the section canvas;
           the desktop loop is the section background) -->
      <div class="relative -mx-4 sm:-mx-6 -mt-16 md:-mt-24 order-first lg:hidden">
        <video
          data-hero-video
          src="/videos/hero-midnight-tall.mp4"
          poster={tall.src}
          muted
          loop
          playsinline
          preload="none"
          role="img"
          aria-label="The Working Dev's Hero coding on a city rooftop at night"
          class="w-full aspect-[9/10] md:aspect-[16/10] object-cover object-[center_55%] md:object-[center_30%]"
        ></video>
      </div>
    </div>
    </div>
  </div>

  <!-- Bottom wave decoration (fixed height so it never rides up over the CTAs on wide screens) -->
  <div class="absolute -bottom-px left-0 right-0">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" class="block w-full h-8 sm:h-12 md:h-16 lg:h-24 xl:h-[120px]">
      <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
    </svg>
  </div>
</section>

<script>
  import { syncHeroVideos } from '@/lib/hero-video';

  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-hero-video]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const sync = () => syncHeroVideos(videos, reduceMotion.matches);

  sync();
  reduceMotion.addEventListener('change', sync);
  // Crossing lg swaps which loop is visible.
  matchMedia('(min-width: 1024px)').addEventListener('change', sync);
</script>
