---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';

const projects = [
  {
    title: 'Automate It',
    description: 'Social media on autopilot. AI agents draft on-brand content from plain-English automations — you approve with a swipe. No slop allowed.',
    tags: ['Our Product', 'AI Agents', 'Social Media'],
    href: '/portfolio/automate-it',
    gradient: 'from-brand-purple via-brand-fuchsia to-brand-pink',
  },
  {
    title: 'WDH.sh',
    description: 'An x402 shell toolkit — five pay-per-call CLI tools an AI agent can discover and use with a single funded wallet. No accounts, no API keys.',
    tags: ['x402', 'AI Agents', 'Cloudflare Workers', 'USDC'],
    href: '/portfolio/wdh-sh',
    gradient: 'from-violet-900 to-fuchsia-800',
  },
  {
    title: 'MCP Servers for Revit',
    description: 'Enhanced an open-source project connecting AI assistants to Revit, enabling natural language building design for smart fire suppression prototyping.',
    tags: ['Open Source', 'MCP', 'Revit', 'BIM'],
    href: '/portfolio/mcp-servers-for-revit',
    gradient: 'from-orange-600 to-red-700',
  },
  {
    title: 'Olympia Fitness',
    description: 'A performance tracking application for CSCS trainers to administer tests, track athlete progress, and share results with parents.',
    tags: ['Mobile App', 'iOS', 'Android', 'Capacitor'],
    href: '/portfolio/olympia-fitness',
    gradient: 'from-blue-700 to-blue-900',
  },
];
---

<section class="section bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Featured Work"
      subtitle="See how we've helped clients build amazing products."
      dark
    />

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      {projects.map((project) => (
        <a
          href={project.href}
          class={`group relative overflow-hidden rounded-2xl bg-gradient-to-br ${project.gradient} p-8 md:p-10 transition-transform duration-300 hover:scale-[1.02]`}
        >
          <div class="relative z-10">
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 bg-white/20 rounded-full text-sm backdrop-blur-sm">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-2xl md:text-3xl font-heading font-bold mb-3">
              {project.title}
            </h3>
            <p class="text-white mb-4">
              {project.description}
            </p>
            <span class="inline-flex items-center text-sm font-semibold group-hover:gap-2 transition-all">
              View Case Study
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
          <!-- Background decoration -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        </a>
      ))}
    </div>

    <div class="text-center">
      <Button href="/portfolio" variant="accent">
        View All Projects
      </Button>
    </div>
  </div>
</section>
