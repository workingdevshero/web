---
import SocialIcons from '@components/ui/SocialIcons.astro';
import { DISCORD_INVITE_URL } from '@/data/discord';

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { label: 'Full-Stack Development', href: '/services/full-stack' },
    { label: 'Operations & AI Integration', href: '/services/operations-ai' },
    { label: 'Custom Automations', href: '/services/custom-automations' },
    { label: 'Consulting', href: '/services/consulting' },
  ],
  company: [
    { label: 'About', href: '/about' },
    { label: 'Team', href: '/team' },
    { label: 'Portfolio', href: '/portfolio' },
    { label: 'Blog', href: '/blog' },
    { label: 'Shop', href: '/shop' },
    { label: 'Discord', href: DISCORD_INVITE_URL, external: true },
    { label: 'Contact', href: '/contact' },
  ],
};
---

<footer class="bg-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center mb-4">
          <span class="font-heading font-bold text-xl">
            Working Dev's Hero
          </span>
        </a>
        <p class="text-gray-400 text-sm mb-6">
          AI-enabled software development company. We build AI-powered software that ships.
        </p>
        <SocialIcons />
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-sans font-semibold text-lg mb-4">Services</h3>
        <ul class="space-y-2">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-sans font-semibold text-lg mb-4">Company</h3>
        <ul class="space-y-2">
          {footerLinks.company.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white transition-colors text-sm"
                target={'external' in link && link.external ? '_blank' : undefined}
                rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="font-sans font-semibold text-lg mb-4">Join the Hero Squad</h3>
        <p class="text-gray-400 text-sm mb-4">
          Get AI insights, dev tips, and updates delivered to your inbox.
        </p>
        <a
          href="/newsletter"
          class="inline-block btn-primary text-sm"
        >
          Subscribe
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} Working Dev's Hero. All rights reserved.
      </p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a href="/privacy" class="text-gray-400 hover:text-white text-sm transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-gray-400 hover:text-white text-sm transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
