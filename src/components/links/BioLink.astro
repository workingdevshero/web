---
import DiscordMark from '@components/ui/DiscordMark.astro';
import type { BioLink } from '@/data/links';

interface Props {
  link: BioLink;
  featured?: boolean;
}

const { link, featured = false } = Astro.props;
---

<a
  href={link.href}
  target={link.external ? '_blank' : undefined}
  rel={link.external ? 'noopener noreferrer' : undefined}
  class:list={[
    'flex items-center gap-3 w-full min-w-0 px-4 py-3.5 rounded-xl border backdrop-blur-md transition-colors',
    featured
      ? 'bg-brand-gradient border-transparent text-white shadow-lg shadow-purple-900/40'
      : 'bg-white/10 border-white/15 text-white hover:bg-white/15',
  ]}
>
  {link.description ? (
    <span class:list={[
      'w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0',
      featured ? 'bg-white/20' : 'bg-white/10',
    ]}>
      {link.icon === 'discord' && <DiscordMark class="w-4 h-4" />}
      {link.icon === 'bolt' && (
        <svg class="w-5 h-5" viewBox="0 0 48 48" aria-hidden="true"><polygon points="30,6 16,27 23,27 18,42 34,21 26,21" fill="currentColor" /></svg>
      )}
      {link.icon === 'mail' && (
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      )}
      {link.icon === 'youtube' && (
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      )}
      {link.icon === 'instagram' && (
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      )}
      {link.icon === 'tiktok' && (
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.16-.07-.32-.12-.48-.16-1.31-.34-2.58.39-2.89 1.68-.26 1.04.12 2.22 1.06 2.81.95.64 2.23.62 3.11-.08.47-.42.69-1.08.73-1.72.12-2.33.09-4.67.09-7z"/></svg>
      )}
      {link.icon === 'blog' && (
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      )}
    </span>
  ) : null}
  <span class="min-w-0 flex-1 overflow-hidden">
    <strong class="block text-sm font-semibold tracking-tight">{link.title}</strong>
    {link.description && (
      <span class:list={['block text-xs mt-0.5', featured ? 'text-white/85' : 'text-white/70']}>
        {link.description}
      </span>
    )}
  </span>
</a>
