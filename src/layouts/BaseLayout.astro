---
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { PREVIEW_HEIGHT, PREVIEW_WIDTH, socialPreview } from '@/lib/social-preview';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Looping link preview played in place of the image; see src/lib/social-preview.ts. */
  video?: string;
  type?: 'website' | 'article';
  chrome?: 'full' | 'none';
  bodyClass?: string;
}

const {
  title,
  description = "Working Dev's Hero - AI-enabled software development company. We build AI-powered software that ships.",
  image,
  video,
  type = 'website',
  chrome = 'full',
  bodyClass = 'bg-white',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { image: socialImageURL, video: socialVideoURL } = socialPreview(Astro.site!, image, video);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title} | Working Dev's Hero</title>
    <meta name="title" content={`${title} | Working Dev's Hero`} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Working Dev's Hero`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Working Dev's Hero — We build AI-powered software that ships" />
    {socialVideoURL && (
      <>
        <meta property="og:video" content={socialVideoURL} />
        <meta property="og:video:secure_url" content={socialVideoURL} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content={PREVIEW_WIDTH} />
        <meta property="og:video:height" content={PREVIEW_HEIGHT} />
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Working Dev's Hero`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Self-hosted display font -->
    <link rel="preload" href="/fonts/BricolageGrotesque-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- PostHog web analytics (shared WDH project, product = workingdevshero) -->
    <script>
      import posthog from 'posthog-js';
      import { initAnalytics } from '@/lib/analytics';

      initAnalytics(posthog);
    </script>

    <!-- Feeds, and the plain-text site index for AI agents (see src/utils/agentContent.ts) -->
    <link rel="alternate" type="application/rss+xml" title="Working Dev's Hero Blog" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="Index for AI agents (llms.txt)" href="/llms.txt" />

    <slot name="head" />
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    {chrome === 'full' && <Header />}
    <main class="flex-grow">
      <slot />
    </main>
    {chrome === 'full' && <Footer />}
  </body>
</html>
