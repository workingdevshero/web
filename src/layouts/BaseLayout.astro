---
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { PREVIEW_HEIGHT, PREVIEW_WIDTH, socialPreview } from '@/lib/social-preview';
import { getCollection } from 'astro:content';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Looping link preview played in place of the image; see src/lib/social-preview.ts. */
  video?: string;
  type?: 'website' | 'article';
  chrome?: 'full' | 'none';
  bodyClass?: string;
  /** Article-only: when the post was first published. */
  publishedDate?: Date;
  /** Article-only: when the post was last updated. */
  updatedDate?: Date;
  /** Article-only: byline name. */
  author?: string;
  /** Article-only: emitted as JSON-LD keywords. */
  tags?: string[];
}

const {
  title,
  description = "Working Dev's Hero - AI-enabled software development company. We build AI-powered software that ships.",
  image,
  video,
  type = 'website',
  chrome = 'full',
  bodyClass = 'bg-white',
  publishedDate,
  updatedDate,
  author,
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// A page video's first frame is its image (tested for blog posts), so they share a size.
const { image: socialImageURL, video: socialVideo } = socialPreview(Astro.site!, image, video);

// Newest published post: the modification date of pages that list posts.
const posts = await getCollection('blog', ({ data }) => !data.draft);
const siteLatest = posts
  .map((p) => p.data.updatedDate ?? p.data.pubDate)
  .reduce((acc, d) => (d > acc ? d : acc), new Date(0));

const siteURL = new URL('/', Astro.site).href;
const isHome = Astro.url.pathname === '/';
const listsPosts = /^\/(?:blog(?:\/(?:category|tag)\/.*)?\/?)?$/.test(Astro.url.pathname);

// Articles use their own dates; listing pages use the newest post; other pages emit no date.
const pub = type === 'article' ? (publishedDate ?? siteLatest) : undefined;
const mod =
  type === 'article' ? (updatedDate ?? publishedDate ?? siteLatest) : listsPosts ? siteLatest : undefined;

const publisher = {
  '@type': 'Organization',
  name: "Working Dev's Hero",
  url: siteURL,
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href },
};
const website = { '@type': 'WebSite', '@id': `${siteURL}#website`, name: "Working Dev's Hero", url: siteURL };

// JSON-LD structured data: BlogPosting for articles; otherwise a WebPage (CollectionPage
// for post listings) that is part of the WebSite, which is only described in full on the homepage.
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: socialImageURL.href,
        datePublished: pub!.toISOString(),
        dateModified: mod!.toISOString(),
        ...(author && { author: { '@type': 'Person', name: author } }),
        publisher,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
        ...(tags.length > 0 && { keywords: tags.join(', ') }),
      }
    : {
        '@context': 'https://schema.org',
        '@graph': [
          isHome ? { ...website, description, publisher } : website,
          {
            '@type': listsPosts && !isHome ? 'CollectionPage' : 'WebPage',
            '@id': canonicalURL.href,
            url: canonicalURL.href,
            name: title,
            description,
            isPartOf: { '@id': website['@id'] },
            ...(mod && { dateModified: mod.toISOString() }),
          },
        ],
      };
// Escape <, > and & so JSON-LD cannot break out of the surrounding <script> tag.
const jsonLdHtml = JSON.stringify(jsonLd)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title} | Working Dev's Hero</title>
    <meta name="title" content={`${title} | Working Dev's Hero`} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Working Dev's Hero`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={socialVideo?.width ?? PREVIEW_WIDTH} />
    <meta property="og:image:height" content={socialVideo?.height ?? PREVIEW_HEIGHT} />
    <meta property="og:image:alt" content="Working Dev's Hero — We build AI-powered software that ships" />
    {mod && <meta property="og:updated_time" content={mod.toISOString()} />}
    {pub && mod && (
      <>
        <meta property="article:published_time" content={pub.toISOString()} />
        <meta property="article:modified_time" content={mod.toISOString()} />
        {author && <meta property="article:author" content={author} />}
      </>
    )}
    {socialVideo && (
      <>
        <meta property="og:video" content={socialVideo.url} />
        <meta property="og:video:secure_url" content={socialVideo.url} />
        <meta property="og:video:type" content="video/mp4" />
        <meta property="og:video:width" content={socialVideo.width} />
        <meta property="og:video:height" content={socialVideo.height} />
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Working Dev's Hero`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Self-hosted display font -->
    <link rel="preload" href="/fonts/BricolageGrotesque-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- PostHog web analytics (shared WDH project, product = workingdevshero) -->
    <script>
      import posthog from 'posthog-js';
      import { initAnalytics } from '@/lib/analytics';

      initAnalytics(posthog);
    </script>

    <!-- Feeds, and the plain-text site index for AI agents (see src/utils/agentContent.ts) -->
    <link rel="alternate" type="application/rss+xml" title="Working Dev's Hero Blog" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="Index for AI agents (llms.txt)" href="/llms.txt" />

    <!-- Structured data: tells crawlers the real publication and modification dates. -->
    <script is:inline type="application/ld+json" set:html={jsonLdHtml} />

    <slot name="head" />
  </head>
  <body class:list={['min-h-screen flex flex-col', bodyClass]}>
    {chrome === 'full' && <Header />}
    <main class="flex-grow">
      <slot />
    </main>
    {chrome === 'full' && <Footer />}
  </body>
</html>
