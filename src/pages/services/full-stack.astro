const features = [
  'Web application development',
  'Mobile app development',
  'Desktop app development',
  'Backend API design and implementation',
  'Database architecture and optimization',
  'Cloud infrastructure setup',
  'CI/CD pipeline configuration',
  'Microservices architecture design',
  'Real-time features and WebSocket implementations',
];

const benefits = [
  {
    title: 'End-to-End Expertise',
    description: 'From frontend to backend to infrastructure, we handle the entire stack so you get a cohesive, well-architected solution.',
  },
  {
    title: 'Modern Best Practices',
